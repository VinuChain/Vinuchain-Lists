{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/VinuChain/vinuchain-lists/schemas/contract.schema.json",
  "title": "Contract Project Info",
  "description": "Schema for contract project info.json files",
  "type": "object",
  "required": [
    "name",
    "website",
    "contracts"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name",
      "minLength": 1,
      "maxLength": 100
    },
    "website": {
      "type": "string",
      "description": "Project website HTTPS URL",
      "pattern": "^https://[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*(/[^\\s]*)?$",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "description": "Project description",
      "minLength": 1,
      "maxLength": 500
    },
    "contact": {
      "type": "string",
      "description": "Contact email address",
      "format": "email",
      "maxLength": 320
    },
    "security": {
      "type": "string",
      "description": "Security contact email address",
      "format": "email",
      "maxLength": 320
    },
    "contracts": {
      "type": "array",
      "description": "List of all contract addresses in this project",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "name",
          "address",
          "type",
          "chainId",
          "codeHash"
        ],
        "properties": {
          "chainId": {
            "type": "integer",
            "description": "VinuChain network the contract is deployed on: 206 = testnet, 207 = mainnet. Required per-contract because a single project (e.g. vinuchain) legitimately mixes mainnet core contracts with testnet-only quota/VNS deployments. The on-chain validator verifies code exists at the address on this chain.",
            "enum": [
              206,
              207
            ]
          },
          "name": {
            "type": "string",
            "description": "Contract name in PascalCase (e.g., 'Factory', 'Router')",
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "minLength": 1,
            "maxLength": 100
          },
          "artifact": {
            "type": "string",
            "description": "Source and ABI artifact name when a deployed address uses files named after a different contract",
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "minLength": 1,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "description": "EIP-55 checksummed contract address",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "codeHash": {
            "type": "string",
            "description": "Optional bytecode-type pin: keccak256 of the deployed runtime bytecode (eth_getCode) for this address on its declared chainId. Pins the contract TYPE \u2014 proves the expected bytecode is deployed here. A mismatch hard-errors. Note: codeHash pins type, not a unique instance; multiple contracts can share identical bytecode. When absent, the validator emits a warning. Capture/refresh with `npm run capture:codehashes`.",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          },
          "implCodeHash": {
            "type": "string",
            "description": "Optional EIP-1967 implementation pin for proxy contracts: keccak256 of the implementation contract's runtime bytecode (eth_getCode on the address found at EIP-1967 slot 0x360894...). When present, the on-chain validator reads the implementation slot via eth_getStorageAt and hard-errors if the implementation's bytecode hash differs \u2014 catches an implementation upgrade or replacement without touching the proxy shell. Capture/refresh with `npm run capture:codehashes`.",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          },
          "type": {
            "type": "string",
            "description": "Contract type",
            "enum": [
              "token",
              "factory",
              "router",
              "controller",
              "manager",
              "quoter",
              "helper",
              "oracle",
              "vault",
              "staking",
              "governance",
              "bridge",
              "nft",
              "pair",
              "pool",
              "lending",
              "core",
              "periphery",
              "utility",
              "system",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "description": "Contract description",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    "social": {
      "type": "object",
      "description": "Social media links",
      "properties": {
        "github": {
          "type": "string",
          "description": "GitHub organization or repository HTTPS URL",
          "pattern": "^https://github\\.com/[a-zA-Z0-9_-]+(/[a-zA-Z0-9_.-]+)?/?$",
          "maxLength": 500
        },
        "twitter": {
          "type": "string",
          "description": "Twitter/X profile HTTPS URL",
          "pattern": "^https://(twitter\\.com|x\\.com)/[a-zA-Z0-9_]+$",
          "maxLength": 500
        },
        "telegram": {
          "type": "string",
          "description": "Telegram channel or group URL",
          "pattern": "^https://t\\.me/[a-zA-Z0-9_]+$",
          "maxLength": 500
        },
        "discord": {
          "type": "string",
          "description": "Discord server invite HTTPS URL",
          "pattern": "^https://(discord\\.gg|discord\\.com/invite)/[a-zA-Z0-9]+$",
          "maxLength": 500
        },
        "medium": {
          "type": "string",
          "description": "Medium publication HTTPS URL",
          "pattern": "^https://medium\\.com/@[a-zA-Z0-9_-]+(/[^\\s]*)?$",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "marketplace": {
      "type": "object",
      "description": "Optional block that lists this project in the VinuExplorer dApp marketplace directory. When present, build-marketplace.js emits an entry per network listed in `networks`.",
      "required": [
        "id",
        "title",
        "url",
        "logo",
        "shortDescription",
        "description",
        "categories",
        "author",
        "external",
        "networks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "URL-safe slug uniquely identifying this dApp in the marketplace (lowercase, hyphens allowed)",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Human-readable display name shown in the marketplace",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "description": "Primary HTTPS URL for the dApp",
          "pattern": "^https://",
          "maxLength": 500
        },
        "logo": {
          "type": "string",
          "description": "HTTPS URL for the dApp logo image (SVG or PNG recommended)",
          "pattern": "^https://",
          "maxLength": 500
        },
        "shortDescription": {
          "type": "string",
          "description": "One-line summary shown in marketplace cards (max 160 chars)",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Full description shown on the dApp detail page",
          "minLength": 1,
          "maxLength": 1000
        },
        "categories": {
          "type": "array",
          "description": "Marketplace category tags. Allowed values: DEX, Lending, NFT, Bridge, Governance, Staking, Tools, Other",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": ["DEX", "Lending", "NFT", "Bridge", "Governance", "Staking", "Tools", "Other"]
          }
        },
        "author": {
          "type": "string",
          "description": "Author or organisation name displayed in the marketplace",
          "minLength": 1,
          "maxLength": 100
        },
        "external": {
          "type": "boolean",
          "description": "True when the dApp is hosted outside the explorer domain (the explorer opens it in a new tab)"
        },
        "networks": {
          "type": "array",
          "description": "Chain IDs where this entry should appear: 207 = mainnet, 206 = testnet",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "enum": [206, 207]
          }
        },
        "site": {
          "type": "string",
          "description": "Optional secondary site URL (used by some Blockscout builds alongside `url`)",
          "pattern": "^https://",
          "maxLength": 500
        },
        "twitter": {
          "type": "string",
          "description": "Twitter/X profile HTTPS URL",
          "pattern": "^https://(twitter\\.com|x\\.com)/[a-zA-Z0-9_]+$",
          "maxLength": 500
        },
        "telegram": {
          "type": "string",
          "description": "Telegram channel or group HTTPS URL",
          "pattern": "^https://t\\.me/[a-zA-Z0-9_]+$",
          "maxLength": 500
        },
        "discord": {
          "type": "string",
          "description": "Discord server invite HTTPS URL",
          "pattern": "^https://(discord\\.gg|discord\\.com/invite)/[a-zA-Z0-9]+$",
          "maxLength": 500
        },
        "github": {
          "type": "string",
          "description": "GitHub organisation or repository HTTPS URL",
          "pattern": "^https://github\\.com/[a-zA-Z0-9_-]+(/[a-zA-Z0-9_.-]+)?/?$",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "related_registries": {
      "type": "array",
      "description": "Cross-references to sibling contract registries in this repository (e.g. VNS, VinuSwap)",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the related registry",
            "minLength": 1,
            "maxLength": 100
          },
          "path": {
            "type": "string",
            "description": "Repository-relative path from this info.json to the related registry directory",
            "pattern": "^\\.{1,2}/[A-Za-z0-9._/-]+$",
            "maxLength": 200
          },
          "network": {
            "type": "string",
            "description": "Network qualifier such as 'mainnet-207' or 'testnet-206'",
            "minLength": 1,
            "maxLength": 50
          },
          "summary": {
            "type": "string",
            "description": "Short prose describing the related registry and its current rollout state",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
