{
  "name": "vinuchain-lists",
  "version": "1.0.0",
  "description": "VinuChain Lists - Comprehensive registry of tokens and smart contracts on VinuChain",
  "main": "scripts/validate.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "files": [
    "tokens",
    "contracts",
    "schemas",
    "scripts"
  ],
  "scripts": {
    "validate": "node scripts/validate.js",
    "validate:onchain": "node scripts/validate-onchain.js",
    "capture:codehashes": "node scripts/capture-codehashes.js",
    "audit:vinuchain-quota": "node scripts/audit-vinuchain-quota.js",
    "finalize:vinuchain-quota": "node scripts/finalize-vinuchain-quota.js",
    "vns:oracle:dry-run": "node scripts/update-vns-oracle.js",
    "vns:oracle:update": "node scripts/update-vns-oracle.js --send",
    "test": "npm run test:mocha && npm run test:hardhat",
    "test:mocha": "mocha 'tests/**/*.test.js' --ignore 'tests/**/*.hh.test.js'",
    "test:hardhat": "hardhat test tests/**/*.hh.test.js",
    "test:unit": "mocha 'tests/unit/**/*.test.js' --ignore 'tests/**/*.hh.test.js' && npm run test:hardhat",
    "test:integration": "mocha tests/integration/**/*.test.js",
    "test:security": "mocha tests/security/**/*.test.js",
    "test:all": "npm run validate && npm run validate:marketplace && npm test",
    "test:verbose": "mocha 'tests/**/*.test.js' --ignore 'tests/**/*.hh.test.js' --reporter spec && npm run test:hardhat",
    "test:watch": "mocha 'tests/**/*.test.js' --ignore 'tests/**/*.hh.test.js' --watch",
    "build:marketplace": "node scripts/build-marketplace.js --out dist",
    "validate:marketplace": "node scripts/validate-marketplace.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinuChain/vinuchain-lists.git"
  },
  "keywords": [
    "vinuchain",
    "tokens",
    "contracts",
    "erc20",
    "blockchain",
    "registry",
    "smart-contracts",
    "abi",
    "solidity",
    "defi"
  ],
  "author": "VinuChain Community",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VinuChain/vinuchain-lists/issues"
  },
  "homepage": "https://github.com/VinuChain/vinuchain-lists#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.6",
    "mocha": "^11.7.6"
  }
}
